# ---- PostgreSQL (compose service `postgres`) ----
POSTGRES_USER=paperless
POSTGRES_PASSWORD=paperless
POSTGRES_DB=fiskobox

# Async DSN used by backend, bot, Alembic (host = compose service name)
DATABASE_URL=postgresql+asyncpg://paperless:paperless@postgres:5432/fiskobox

# ---- Redis (Celery broker + result backend + link codes) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- JWT (web auth) ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_BOT_USERNAME=fiskobox_bot

# ---- OCR ----
# OCR_PROVIDER: google | tesseract  (aws reserved)
# With google: on API failure / quota exhaustion fallback to tesseract.
OCR_PROVIDER=google
OCR_ENGINE=tesseract
TESSERACT_LANGUAGES=ukr+rus+eng
OCR_TIMEOUT_SECONDS=30
# In docker: put JSON at ./secrets/google-vision.json
# Path inside the container (compose mounts ./secrets -> /secrets):
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-vision.json
# Free Vision quota ~1000 requests/month (counter in Redis)
GOOGLE_VISION_MONTHLY_LIMIT=1000
GOOGLE_VISION_WARN_THRESHOLD=900
# true = force Tesseract when the limit is reached
GOOGLE_VISION_ENFORCE_LIMIT=true

# ---- Parser (Ollama LLM) ----
# PARSER_MODE: regex | llm | hybrid
# hybrid = Ollama → regex fill-in → manual review (recommended)
PARSER_MODE=hybrid
# In docker-compose: http://ollama:11434  |  on host: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.1

# ---- Storage ----
UPLOAD_DIR=/data/uploads

# ---- Edge cases ----
PHOTO_RATE_LIMIT=10
PHOTO_RATE_WINDOW_SECONDS=60
BLUR_VARIANCE_THRESHOLD=100.0
BLUR_WARN_VARIANCE_THRESHOLD=250.0

# ---- Frontend (build args) ----
VITE_API_BASE_URL=http://localhost:8000/api
VITE_TELEGRAM_BOT_USERNAME=fiskobox_bot

# ---- Production (docker-compose.prod.yml / Caddy) ----
# Domain pointed by your VPS A record. Caddy will issue HTTPS for it.
# For HTTP-only demo without a domain: DOMAIN=:80
DOMAIN=fiskobox.example.com
